# Security headers for the OZONE Shield website (Cloudflare Workers static assets).
# Every page loads only its own files. The one exception is Cloudflare Turnstile,
# the bot check, which needs its script and iframe from challenges.cloudflare.com.
# Pages never inline scripts or styles, so no 'unsafe-inline' is needed.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://ozone-analyse.bbaranda055.workers.dev; img-src 'self' data:; style-src 'self'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

# The game runs entirely in the browser: no third-party scripts, frames or network calls.
/spot-the-scam/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; frame-src 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Fonts never change under the same name, so browsers can keep them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
